-- ---------------------------------------------------------------------
-- 11. ALERTAS: criação, código curto, envio, escalada
-- ---------------------------------------------------------------------
create or replace function public.alertas_antes_inserir()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  v_cfg  configuracao_niveis_alerta;
  v_inst instituicoes;
begin
  select * into v_cfg from configuracao_niveis_alerta where nivel = new.nivel;
  select * into v_inst from instituicoes where id = new.instituicao_id;

  if not found then
    raise exception 'Instituição inexistente';
  end if;
  if v_inst.estado <> 'verificada' and not eh_admin() then
    raise exception 'Instituição ainda não verificada';
  end if;

  if new.lat is null or new.lng is null then
    new.lat := v_inst.lat;
    new.lng := v_inst.lng;
  end if;
  if new.lat is null or new.lng is null then
    raise exception 'Defina a localização da instituição ou do alerta';
  end if;

  new.estado := 'ativo';
  new.raio_atual_km := v_cfg.raio_padrao_km;
  new.expira_em := coalesce(new.expira_em, now() + make_interval(hours => v_cfg.expira_apos_horas));
  return new;
end $$;

-- prefixos a_ e b_ garantem a ordem de execução dos triggers
create trigger alertas_a_antes_inserir_trg
  before insert on public.alertas
  for each row execute function public.alertas_antes_inserir();

create or replace function public.alertas_definir_codigo_curto()
returns trigger language plpgsql security definer set search_path = public as $$
declare v text; tentativas int := 0;
begin
  loop
    v := lpad((floor(random() * 10000))::int::text, 4, '0');
    exit when not exists (select 1 from alertas where codigo_curto = v and estado = 'ativo');
    tentativas := tentativas + 1;
    if tentativas > 50 then
      v := lpad((floor(random() * 1000000))::int::text, 6, '0');
      exit;
    end if;
  end loop;
  new.codigo_curto := v;
  return new;
end $$;

create trigger alertas_b_codigo_curto_trg
  before insert on public.alertas
  for each row execute function public.alertas_definir_codigo_curto();

-- Cria as notificações (pendentes) para os doadores elegíveis
create or replace function public.despachar_alerta(p_alerta_id uuid)
returns integer language plpgsql security definer set search_path = public, extensions as $$
declare
  v_alerta alertas;
  v_cfg    configuracao_niveis_alerta;
  v_sangue int;
  n        int;
begin
  select * into v_alerta from alertas where id = p_alerta_id and estado = 'ativo';
  if not found or v_alerta.localizacao is null then return 0; end if;

  select * into v_cfg from configuracao_niveis_alerta where nivel = v_alerta.nivel;
  select id into v_sangue from categorias where slug = 'sangue';

  insert into notificacoes (alerta_id, doador_id, canal, distancia_m)
  select v_alerta.id, d.utilizador_id, c.canal,
         round(st_distance(d.localizacao, v_alerta.localizacao))::int
  from doadores d
  cross join unnest(v_cfg.canais) as c(canal)
  where d.disponivel
    and d.localizacao is not null
    and v_alerta.nivel >= d.nivel_minimo_alerta
    and st_dwithin(d.localizacao, v_alerta.localizacao, v_alerta.raio_atual_km * 1000)
    -- abaixo de "urgente" respeita a distância máxima escolhida pelo doador
    and (v_alerta.nivel >= 'urgente'
         or st_dwithin(d.localizacao, v_alerta.localizacao, d.distancia_maxima_km * 1000))
    and (v_alerta.categoria_id is null or exists (
          select 1 from doadores_categorias dc
          where dc.doador_id = d.utilizador_id and dc.categoria_id = v_alerta.categoria_id))
    -- alerta de sangue com tipo definido: só doadores compatíveis
    and (v_alerta.tipo_sanguineo_necessario is null or exists (
          select 1 from compatibilidade_sanguinea cs
          where cs.tipo_doador = d.tipo_sanguineo
            and cs.tipo_recetor = v_alerta.tipo_sanguineo_necessario))
    -- alerta de sangue: só doadores aptos
    and (v_alerta.categoria_id is distinct from v_sangue
         or (select ap.apto from public.calcular_aptidao(d.utilizador_id) ap))
  on conflict (alerta_id, doador_id, canal) do nothing;

  get diagnostics n = row_count;
  return n;
end $$;

create or replace function public.alertas_depois_inserir()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  perform despachar_alerta(new.id);
  return new;
end $$;

