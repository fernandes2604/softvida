-- 10. VISTA PÚBLICA: qualquer pessoa vê só tipo sanguíneo + contacto
-- ---------------------------------------------------------------------
create view public.doadores_publicos as
select d.tipo_sanguineo, p.telefone
from public.doadores d
join public.perfis p on p.id = d.utilizador_id
where d.perfil_publico
  and d.disponivel
  and d.tipo_sanguineo is not null
