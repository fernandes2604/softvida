  categoria_id              int  not null references public.categorias(id),
  tipo_sanguineo_necessario public.tipo_sanguineo,
  quantidade                int  not null default 1 check (quantidade between 1 and 1000),
  descricao                 text check (descricao is null or length(descricao) <= 1000),
  nivel                     public.nivel_alerta not null default 'atencao',
  -- onde a ajuda é necessária (local de atendimento no terreno)
  lat                       double precision check (lat between -90 and 90),
  lng                       double precision check (lng between -180 and 180),
  localizacao               geography(Point, 4326) generated always as (
                              case
                                when lat is not null and lng is not null
                                then ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography
                                else null
                              end
                            ) stored,
  endereco                  text,
  provincia_id              int references public.provincias(id),
  municipio_id              int references public.municipios(id),
  -- tratamento
  estado                    public.estado_pedido not null default 'pendente',
  instituicao_id            uuid references public.instituicoes(id) on delete set null,
  atribuido_em              timestamptz,
  aceite_em                 timestamptz,
  concluido_em              timestamptz,
  notas_instituicao         text,
  alerta_id                 uuid references public.alertas(id) on delete set null,
  criado_em                 timestamptz not null default now(),
  atualizado_em             timestamptz not null default now(),
  constraint pedido_coordenadas_ck check ((lat is null) = (lng is null)),
  constraint pedido_local_ck check (lat is not null or provincia_id is not null)
);

create index pedidos_doacao_localizacao_gix on public.pedidos_doacao using gist (localizacao);
create index pedidos_doacao_instituicao_idx on public.pedidos_doacao (instituicao_id, estado);
create index pedidos_doacao_estado_idx      on public.pedidos_doacao (estado, criado_em);
create index pedidos_doacao_telefone_idx    on public.pedidos_doacao (telefone_solicitante, criado_em desc);
create index pedidos_doacao_utilizador_idx  on public.pedidos_doacao (utilizador_id);

create trigger pedidos_doacao_carimbo_trg
  before update on public.pedidos_doacao
  for each row execute function public.carimbar_atualizado_em();

-- Histórico de instituições a quem o pedido foi atribuído
create table public.pedidos_tentativas (
  id             uuid primary key default gen_random_uuid(),
  pedido_id      uuid not null references public.pedidos_doacao(id) on delete cascade,
  instituicao_id uuid not null references public.instituicoes(id) on delete cascade,
  atribuido_em   timestamptz not null default now(),
  respondido_em  timestamptz,
  resultado      text not null default 'pendente'
                 check (resultado in ('pendente', 'aceite', 'recusado', 'expirado')),
  motivo         text,
  unique (pedido_id, instituicao_id)
);

create index pedidos_tentativas_instituicao_idx on public.pedidos_tentativas (instituicao_id);

-- ---------------------------------------------------------------------
-- 19. FUNÇÕES INTERNAS DOS PEDIDOS
-- ---------------------------------------------------------------------
-- Código de 8 caracteres sem letras ambíguas (I, L, O) nem 0/1
create or replace function public.gerar_codigo_pedido()
returns text language plpgsql security definer set search_path = public as $$
declare
  v_alfabeto constant text := 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
  v_bytes    bytea;
  v          text;
  i          int;
begin
  loop
    v_bytes := decode(replace(gen_random_uuid()::text, '-', ''), 'hex');
    v := '';
    for i in 0..7 loop
      v := v || substr(v_alfabeto, 1 + (get_byte(v_bytes, i) % length(v_alfabeto)), 1);
    end loop;
    exit when not exists (select 1 from pedidos_doacao where codigo = v);
  end loop;
  return v;
end $$;

-- Atribui o pedido pendente à instituição verificada mais próxima que
-- ainda não tenha sido tentada. Devolve o id da instituição (ou nulo).
create or replace function public.atribuir_pedido(p_pedido_id uuid)
returns uuid language plpgsql security definer set search_path = public, extensions as $$
declare
  v_p      pedidos_doacao;
  v_inst   uuid;
  v_sangue int;
begin
  select * into v_p from pedidos_doacao
   where id = p_pedido_id and estado = 'pendente'
   for update;
  if not found then return null; end if;

  select id into v_sangue from categorias where slug = 'sangue';

  select i.id into v_inst
  from instituicoes i
  where i.estado = 'verificada'
    and not exists (select 1 from pedidos_tentativas t
                    where t.pedido_id = v_p.id and t.instituicao_id = i.id)
    -- sangue: apenas instituições com capacidade clínica
    and (v_p.categoria_id is distinct from v_sangue
         or i.tipo in ('hospital', 'clinica', 'banco_de_sangue'))
  order by
    case when v_p.localizacao is not null and i.localizacao is not null
         then st_distance(i.localizacao, v_p.localizacao)
         else 1e12::float8 end,
    -- sem coordenadas: prefere o mesmo município, depois a mesma província
    coalesce(i.municipio_id = v_p.municipio_id, false) desc,
    coalesce(i.provincia_id = v_p.provincia_id, false) desc,
    i.criado_em
  limit 1;

  if v_inst is null then return null; end if;

  insert into pedidos_tentativas (pedido_id, instituicao_id) values (v_p.id, v_inst);

  update pedidos_doacao
     set instituicao_id = v_inst,
         estado = 'atribuido',
         atribuido_em = now()
   where id = v_p.id;

  return v_inst;
end $$;

-- Reatribui pedidos sem resposta a tempo e tenta de novo os sem instituição.
-- Tempo para responder: critico 10 min, urgente 15 min, restantes 30 min.
create or replace function public.reatribuir_pedidos()
returns integer language plpgsql security definer set search_path = public as $$
declare r record; total int := 0;
begin
  for r in
    select p.id from pedidos_doacao p
    where p.estado = 'atribuido'
      and p.atribuido_em < now() - make_interval(mins =>
            case p.nivel when 'critico' then 10 when 'urgente' then 15 else 30 end)
  loop
    update pedidos_tentativas
       set resultado = 'expirado', respondido_em = now()
     where pedido_id = r.id and resultado = 'pendente';

    update pedidos_doacao
       set estado = 'pendente', instituicao_id = null, atribuido_em = null
     where id = r.id;
  end loop;

  for r in
    select id from pedidos_doacao where estado = 'pendente' order by criado_em
  loop
    if atribuir_pedido(r.id) is not null then total := total + 1; end if;
  end loop;

  return total;
end $$;

select cron.schedule('reatribuir-pedidos', '* * * * *', $$select public.reatribuir_pedidos()$$);

-- ---------------------------------------------------------------------
-- 20. FUNÇÕES PÚBLICAS DOS PEDIDOS (qualquer pessoa, mesmo sem login)
-- ---------------------------------------------------------------------
create or replace function public.solicitar_doacao(
  p_nome           text,
  p_telefone       text,
  p_categoria_id   int,
  p_descricao      text default null,
  p_lat            double precision default null,
  p_lng            double precision default null,
  p_endereco       text default null,
  p_provincia_id   int default null,
  p_municipio_id   int default null,
  p_tipo_sanguineo public.tipo_sanguineo default null,
  p_quantidade     int default 1,
  p_nivel          public.nivel_alerta default 'atencao'
)
returns table (o_codigo text, o_estado public.estado_pedido, o_instituicao text)
language plpgsql security definer set search_path = public, extensions as $$
declare
  v_tel      text;
  v_id       uuid;
  v_codigo   text;
  v_mun_prov int;
begin
  -- normaliza o telefone (aceita 9XXXXXXXX, 244..., 00244... ou +244...)
  v_tel := regexp_replace(coalesce(p_telefone, ''), '[^0-9+]', '', 'g');
  if    v_tel ~ '^9[0-9]{8}$'    then v_tel := '+244' || v_tel;
  elsif v_tel ~ '^244[0-9]{9}$'  then v_tel := '+' || v_tel;
  elsif v_tel ~ '^00'            then v_tel := '+' || substr(v_tel, 3);
  end if;
  if v_tel !~ '^\+[1-9][0-9]{7,14}$' then
    raise exception 'Telefone inválido';
  end if;

  if p_nome is null or length(trim(p_nome)) < 2 then
    raise exception 'Indique o seu nome';
  end if;
  if not exists (select 1 from categorias where id = p_categoria_id) then
    raise exception 'Categoria inválida';
  end if;
  if (p_lat is null) <> (p_lng is null) then
    raise exception 'Indique latitude e longitude em conjunto';
  end if;

  -- deduz a província a partir do município, se necessário
  if p_provincia_id is null and p_municipio_id is not null then
    select provincia_id into v_mun_prov from municipios where id = p_municipio_id;
  end if;
  if p_lat is null and coalesce(p_provincia_id, v_mun_prov) is null then
    raise exception 'Indique a localização (GPS) ou, pelo menos, a província';
  end if;

  -- proteção básica contra abuso (anónimos): máx. 5 pedidos / 24 h por telefone
  if (select count(*) from pedidos_doacao
       where telefone_solicitante = v_tel
         and criado_em > now() - interval '24 hours') >= 5 then
    raise exception 'Demasiados pedidos com este telefone. Tente mais tarde.';
  end if;

  v_codigo := gerar_codigo_pedido();

  insert into pedidos_doacao (
    codigo, utilizador_id, nome_solicitante, telefone_solicitante, categoria_id,
    tipo_sanguineo_necessario, quantidade, descricao, nivel, lat, lng, endereco,
    provincia_id, municipio_id)
  values (
    v_codigo, auth.uid(), trim(p_nome), v_tel, p_categoria_id,
    p_tipo_sanguineo, greatest(coalesce(p_quantidade, 1), 1), p_descricao, p_nivel, p_lat, p_lng, p_endereco,
    coalesce(p_provincia_id, v_mun_prov), p_municipio_id)
  returning id into v_id;

  perform atribuir_pedido(v_id);

  return query
  select p.codigo, p.estado, i.nome
  from pedidos_doacao p
  left join instituicoes i on i.id = p.instituicao_id
  where p.id = v_id;
end $$;

-- Acompanhamento pelo código (o contacto da instituição só aparece depois de aceite)
create or replace function public.acompanhar_pedido(p_codigo text)
returns table (
  estado public.estado_pedido, categoria text, criado_em timestamptz,
  instituicao_nome text, instituicao_telefone text, instituicao_endereco text,
  aceite_em timestamptz, concluido_em timestamptz
)
language sql stable security definer set search_path = public as $$
  select p.estado, c.nome, p.criado_em,
         case when p.estado in ('atribuido','aceite','em_deslocacao','concluido') then i.nome end,
         case when p.estado in ('aceite','em_deslocacao','concluido') then i.telefone end,
         case when p.estado in ('aceite','em_deslocacao','concluido') then i.endereco end,
         p.aceite_em, p.concluido_em
  from pedidos_doacao p
  join categorias c on c.id = p.categoria_id
  left join instituicoes i on i.id = p.instituicao_id
  where p.codigo = upper(trim(p_codigo));
$$;

create or replace function public.cancelar_meu_pedido(p_codigo text)
returns boolean language plpgsql security definer set search_path = public as $$
declare v_id uuid;
begin
  update pedidos_doacao
     set estado = 'cancelado'
   where codigo = upper(trim(p_codigo))
     and estado in ('pendente', 'atribuido', 'aceite')
  returning id into v_id;

  if v_id is not null then
    -- fecha a tentativa que ainda estava a aguardar resposta
    update pedidos_tentativas
       set resultado = 'expirado', respondido_em = now()
     where pedido_id = v_id and resultado = 'pendente';
  end if;

  return v_id is not null;
end $$;

-- ---------------------------------------------------------------------
-- 21. FUNÇÕES DA INSTITUIÇÃO
-- ---------------------------------------------------------------------
-- Aceitar ou recusar um pedido atribuído. Se recusar, passa à próxima instituição.
create or replace function public.responder_pedido(
  p_pedido_id uuid, p_aceitar boolean, p_motivo text default null
)
returns void language plpgsql security definer set search_path = public as $$
declare v_p pedidos_doacao;
begin
  select * into v_p from pedidos_doacao where id = p_pedido_id for update;
  if not found then raise exception 'Pedido inexistente'; end if;
  if not sou_dono_instituicao(v_p.instituicao_id) then raise exception 'Sem permissão'; end if;
  if v_p.estado <> 'atribuido' then
    raise exception 'O pedido já não está a aguardar resposta';
  end if;

  if p_aceitar then
    update pedidos_tentativas
       set resultado = 'aceite', respondido_em = now()
     where pedido_id = v_p.id and instituicao_id = v_p.instituicao_id;
    update pedidos_doacao set estado = 'aceite', aceite_em = now() where id = v_p.id;
  else
    update pedidos_tentativas
       set resultado = 'recusado', respondido_em = now(), motivo = p_motivo
     where pedido_id = v_p.id and instituicao_id = v_p.instituicao_id;
    update pedidos_doacao
       set estado = 'pendente', instituicao_id = null, atribuido_em = null
     where id = v_p.id;
    perform atribuir_pedido(v_p.id);
  end if;
end $$;

-- Atendimento no terreno: aceite -> em_deslocacao -> concluido
create or replace function public.atualizar_pedido(
  p_pedido_id uuid, p_estado public.estado_pedido, p_notas text default null
)
returns void language plpgsql security definer set search_path = public as $$
declare v_p pedidos_doacao;
begin
  select * into v_p from pedidos_doacao where id = p_pedido_id for update;
  if not found then raise exception 'Pedido inexistente'; end if;
  if not sou_dono_instituicao(v_p.instituicao_id) then raise exception 'Sem permissão'; end if;

  if p_estado = 'em_deslocacao' and v_p.estado <> 'aceite' then
    raise exception 'Só um pedido aceite pode passar a "em deslocação"';
  elsif p_estado = 'concluido' and v_p.estado not in ('aceite', 'em_deslocacao') then
    raise exception 'Só um pedido aceite ou em deslocação pode ser concluído';
  elsif p_estado not in ('em_deslocacao', 'concluido') then
    raise exception 'Estado não permitido';
  end if;

  update pedidos_doacao
     set estado = p_estado,
         notas_instituicao = coalesce(p_notas, notas_instituicao),
         concluido_em = case when p_estado = 'concluido' then now() else concluido_em end
   where id = v_p.id;
end $$;

-- Transforma o pedido aceite num alerta para os doadores próximos
create or replace function public.criar_alerta_do_pedido(
  p_pedido_id uuid, p_nivel public.nivel_alerta default null
)
returns uuid language plpgsql security definer set search_path = public as $$
declare v_p pedidos_doacao; v_cat text; v_alerta uuid;
begin
  select * into v_p from pedidos_doacao where id = p_pedido_id for update;
  if not found then raise exception 'Pedido inexistente'; end if;
  if not sou_dono_instituicao(v_p.instituicao_id) then raise exception 'Sem permissão'; end if;
  if v_p.estado not in ('aceite', 'em_deslocacao') then
    raise exception 'Aceite o pedido antes de criar o alerta';
  end if;
  if v_p.alerta_id is not null then
    raise exception 'Este pedido já tem um alerta';
  end if;

  select nome into v_cat from categorias where id = v_p.categoria_id;

  insert into alertas (instituicao_id, categoria_id, tipo_sanguineo_necessario, nivel,
                       titulo, corpo, lat, lng, doadores_necessarios)
  values (v_p.instituicao_id, v_p.categoria_id, v_p.tipo_sanguineo_necessario,
          coalesce(p_nivel, v_p.nivel),
          'Pedido de doação: ' || v_cat, v_p.descricao, v_p.lat, v_p.lng, v_p.quantidade)
  returning id into v_alerta;

  update pedidos_doacao set alerta_id = v_alerta where id = v_p.id;
  return v_alerta;
end $$;

-- ---------------------------------------------------------------------
-- 22. ADMIN: atribuição manual (quando nenhuma instituição aceita)
-- ---------------------------------------------------------------------
create or replace function public.atribuir_pedido_manual(p_pedido_id uuid, p_instituicao_id uuid)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not eh_admin() then raise exception 'Apenas administradores'; end if;
  if not exists (select 1 from instituicoes where id = p_instituicao_id and estado = 'verificada') then
    raise exception 'Instituição inexistente ou não verificada';
  end if;

  update pedidos_tentativas
     set resultado = 'expirado', respondido_em = now()
   where pedido_id = p_pedido_id and resultado = 'pendente';

  insert into pedidos_tentativas (pedido_id, instituicao_id)
  values (p_pedido_id, p_instituicao_id)
  on conflict (pedido_id, instituicao_id)
  do update set resultado = 'pendente', atribuido_em = now(), respondido_em = null;

  update pedidos_doacao
     set instituicao_id = p_instituicao_id, estado = 'atribuido', atribuido_em = now()
   where id = p_pedido_id and estado in ('pendente', 'atribuido');
end $$;

