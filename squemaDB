create type public.papel_utilizador    as enum ('doador', 'instituicao', 'admin');
create type public.estado_instituicao  as enum ('pendente', 'verificada', 'rejeitada', 'suspensa');
create type public.tipo_instituicao    as enum ('hospital', 'clinica', 'banco_de_sangue', 'ong', 'outra');
-- A ORDEM importa: informativo < atencao < urgente < critico
create type public.nivel_alerta        as enum ('informativo', 'atencao', 'urgente', 'critico');
create type public.estado_alerta       as enum ('rascunho', 'ativo', 'cumprido', 'cancelado', 'expirado');
create type public.canal_notificacao   as enum ('in_app', 'push', 'sms', 'email');
create type public.estado_envio        as enum ('pendente', 'enviado', 'falhou');
create type public.tipo_resposta       as enum ('aceite', 'recusada');
create type public.tipo_sanguineo      as enum ('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-');
create type public.sexo                as enum ('masculino', 'feminino');
create type public.tipo_doacao_orgaos  as enum ('em_vida', 'apos_morte', 'ambos');
create type public.estado_candidatura  as enum ('ativa', 'retirada', 'suspensa');
create type public.estado_pedido       as enum
  ('pendente', 'atribuido', 'aceite', 'em_deslocacao', 'concluido', 'cancelado');

