-- 6. FUNÇÕES AUXILIARES
-- ---------------------------------------------------------------------
create or replace function public.eh_admin()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from perfis where id = auth.uid() and papel = 'admin');
$$;

create or replace function public.meu_papel()
returns public.papel_utilizador language sql stable security definer set search_path = public as $$
  select papel from perfis where id = auth.uid();
$$;

create or replace function public.sou_dono_instituicao(p_id uuid)
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from instituicoes where id = p_id and dono_id = auth.uid());
$$;

create or replace function public.sou_instituicao_verificada()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from instituicoes where dono_id = auth.uid() and estado = 'verificada');
$$;

-- Triggers de validação / carimbo de data
create or replace function public.validar_doador()
returns trigger language plpgsql as $$
begin
  if new.data_nascimento is not null
     and new.data_nascimento > (current_date - interval '18 years')::date then
    raise exception 'É necessário ter pelo menos 18 anos para ser doador';
  end if;
  if new.ultima_doacao_em is not null and new.ultima_doacao_em > now() then
    raise exception 'A data da última doação não pode estar no futuro';
  end if;
  new.atualizado_em := now();
  return new;
end $$;

create trigger doadores_validar_trg
  before insert or update on public.doadores
  for each row execute function public.validar_doador();

create or replace function public.carimbar_atualizado_em()
returns trigger language plpgsql as $$
begin
  new.atualizado_em := now();
  return new;
end $$;

create trigger candidaturas_orgaos_carimbo_trg
  before update on public.candidaturas_orgaos
  for each row execute function public.carimbar_atualizado_em();

-- Cada órgão escolhido tem de ser compatível com o tipo de doação
create or replace function public.validar_item_orgao()
returns trigger language plpgsql security definer set search_path = public as $$
declare v_tipo public.tipo_doacao_orgaos; v_org orgaos;
begin
  select tipo_doacao into v_tipo from candidaturas_orgaos where id = new.candidatura_id;
  select * into v_org from orgaos where id = new.orgao_id;
  if v_tipo = 'em_vida' and not v_org.em_vida then
    raise exception 'O órgão "%" não pode ser doado em vida', v_org.nome;
  end if;
  if v_tipo = 'apos_morte' and not v_org.apos_morte then
    raise exception 'O órgão "%" não pode ser doado após a morte', v_org.nome;
  end if;
  return new;
end $$;

create trigger candidaturas_orgaos_itens_validar_trg
  before insert on public.candidaturas_orgaos_itens
  for each row execute function public.validar_item_orgao();

-- ---------------------------------------------------------------------
-- 7. CRIAÇÃO AUTOMÁTICA DE UTILIZADOR (auto-cadastro de doadores e instituições)
-- Metadados aceites no signUp: papel, nome_completo, telefone,
-- tipo_sanguineo, sexo, data_nascimento, provincia, municipio,
-- instituicao_nome, instituicao_tipo, instituicao_nif e bairro
-- (também aceita role / full_name / phone por compatibilidade)
-- ---------------------------------------------------------------------
create or replace function public.tratar_novo_utilizador()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  v_meta         jsonb := coalesce(new.raw_user_meta_data, '{}'::jsonb);
  v_papel        public.papel_utilizador;
  v_telefone     text;
  v_tipo         public.tipo_sanguineo;
  v_sexo         public.sexo;
  v_tipo_instituicao public.tipo_instituicao;
  v_nascimento   date;
  v_municipio_id int;
  v_provincia_id int;
  v_mun_prov     int;
begin
  -- só 'instituicao' ou 'doador' podem ser pedidos; 'admin' nunca
  v_papel := case when coalesce(v_meta->>'papel', v_meta->>'role') = 'instituicao'
                  then 'instituicao'::public.papel_utilizador
                  else 'doador'::public.papel_utilizador end;

  v_telefone := coalesce(
    v_meta->>'telefone',
    v_meta->>'phone',
    case when coalesce(new.phone, '') <> '' then '+' || ltrim(new.phone, '+') end
  );
  if v_telefone is not null and v_telefone !~ '^\+[1-9][0-9]{7,14}$' then
    v_telefone := null;
  end if;

  insert into perfis (id, papel, nome_completo, telefone)
  values (new.id, v_papel, coalesce(v_meta->>'nome_completo', v_meta->>'full_name'), v_telefone);

  select id into v_provincia_id from provincias
    where lower(nome) = lower(coalesce(v_meta->>'provincia', '')) limit 1;

  select m.id, m.provincia_id into v_municipio_id, v_mun_prov from municipios m
    where lower(m.nome) = lower(coalesce(v_meta->>'municipio', ''))
      and (v_provincia_id is null or m.provincia_id = v_provincia_id)
    limit 1;

  v_provincia_id := coalesce(v_provincia_id, v_mun_prov);

  if v_papel = 'doador' then
    v_tipo := case when v_meta->>'tipo_sanguineo' = any (enum_range(null::public.tipo_sanguineo)::text[])
                   then (v_meta->>'tipo_sanguineo')::public.tipo_sanguineo end;
    v_sexo := case when v_meta->>'sexo' = any (enum_range(null::public.sexo)::text[])
                   then (v_meta->>'sexo')::public.sexo end;
    begin
      v_nascimento := (v_meta->>'data_nascimento')::date;
    exception when others then
      v_nascimento := null;
    end;

    insert into doadores (utilizador_id, tipo_sanguineo, sexo, data_nascimento, provincia_id, municipio_id)
    values (new.id, v_tipo, v_sexo, v_nascimento, v_provincia_id, v_municipio_id);

    -- todo o doador recebe, por omissão, alertas de sangue
    insert into doadores_categorias (doador_id, categoria_id)
    select new.id, id from categorias where slug = 'sangue';
  else
    if nullif(trim(v_meta->>'instituicao_nome'), '') is null then
      raise exception 'O nome da instituição é obrigatório';
    end if;

    v_tipo_instituicao := case
      when v_meta->>'instituicao_tipo' = any (enum_range(null::public.tipo_instituicao)::text[])
        then (v_meta->>'instituicao_tipo')::public.tipo_instituicao
      else 'outra'::public.tipo_instituicao
    end;

    insert into instituicoes (
      dono_id, nome, tipo, nif, telefone, endereco, provincia_id, municipio_id
    )
    values (
      new.id,
      trim(v_meta->>'instituicao_nome'),
      v_tipo_instituicao,
      nullif(trim(v_meta->>'instituicao_nif'), ''),
      v_telefone,
      nullif(concat_ws(', ',
        nullif(trim(v_meta->>'bairro'), ''),
        nullif(trim(v_meta->>'municipio'), ''),
        nullif(trim(v_meta->>'provincia'), '')
      ), ''),
      v_provincia_id,
      v_municipio_id
    );
  end if;

  return new;
end $$;

create trigger ao_criar_utilizador_trg
  after insert on auth.users
  for each row execute function public.tratar_novo_utilizador();

-- ---------------------------------------------------------------------
-- 8. APTIDÃO PARA DOAR SANGUE
-- ---------------------------------------------------------------------
-- Função interna (não exposta à API). Intervalo mínimo: 90 dias (homens)
-- e 120 dias (mulheres).
create or replace function public.calcular_aptidao(p_doador_id uuid)
returns table (apto boolean, proxima_doacao_em date, motivos text[])
language plpgsql stable security definer set search_path = public as $$
declare
  v_d         doadores;
  v_intervalo int;
begin
  select * into v_d from doadores where utilizador_id = p_doador_id;
  motivos := '{}';
  proxima_doacao_em := null;

  if not found then
    apto := false;
    motivos := array['Perfil de doador não encontrado'];
    return next;
    return;
  end if;

  v_intervalo := case when v_d.sexo = 'feminino' then 120 else 90 end;

  if v_d.tipo_sanguineo is null then
    motivos := array_append(motivos, 'Tipo sanguíneo não informado');
  end if;
  if v_d.ultima_doacao_em is not null
     and v_d.ultima_doacao_em::date + v_intervalo > current_date then
    proxima_doacao_em := v_d.ultima_doacao_em::date + v_intervalo;
    motivos := array_append(motivos, format('Última doação há menos de %s dias', v_intervalo));
  end if;
  if v_d.peso_kg is not null and v_d.peso_kg < 50 then
    motivos := array_append(motivos, 'Peso inferior a 50 kg');
  end if;
  if v_d.doencas_cronicas is not null and v_d.doencas_cronicas <> 'nenhuma' then
    motivos := array_append(motivos, 'Doença crónica declarada (requer avaliação clínica)');
  end if;
  if v_d.medicacao is not null and v_d.medicacao <> 'nao' then
    motivos := array_append(motivos, 'Medicação em curso (requer avaliação clínica)');
  end if;
  if v_d.tatuagem_recente then
    motivos := array_append(motivos, 'Tatuagem recente (aguardar cerca de 4 meses)');
  end if;
  if v_d.viagem_recente then
    motivos := array_append(motivos, 'Viagem recente (requer avaliação clínica)');
  end if;

  apto := cardinality(motivos) = 0;
  return next;
end $$;

-- O doador consulta a sua própria aptidão e a data da próxima doação possível
create or replace function public.minha_aptidao()
returns table (apto boolean, proxima_doacao_em date, motivos text[])
language sql stable security definer set search_path = public as $$
  select * from public.calcular_aptidao(auth.uid());
$$;

-- ---------------------------------------------------------------------
-- 9. PESQUISA GEOGRÁFICA (para instituições)
-- ---------------------------------------------------------------------
create type public.doador_proximo as (
  doador_id               uuid,
  nome_completo           text,
  tipo_sanguineo          public.tipo_sanguineo,
  telefone                text,
  bairro                  text,
  municipio               text,
  provincia               text,
  distancia_km            numeric,
  ultima_doacao_em        timestamptz,
  dias_desde_ultima_doacao int,
  apto                    boolean,
  proxima_doacao_em       date,
  motivos_inaptidao       text[],
  -- fatores de saúde: só preenchidos se o doador consentiu
  peso_kg                 numeric,
  altura_cm               numeric,
  doencas_cronicas        text,
  medicacao               text,
  tatuagem_recente        boolean,
  viagem_recente          boolean,
  fumador                 boolean,
  consome_alcool          boolean
);

create or replace function public.doadores_proximos(
  p_lat                    double precision,
  p_lng                    double precision,
  p_raio_km                numeric default 10,
  p_categoria_id           int default null,
  p_tipo_sanguineo_recetor public.tipo_sanguineo default null,  -- devolve só doadores compatíveis
  p_apenas_aptos           boolean default false,
  p_limite                 int default 50
)
returns setof public.doador_proximo
language plpgsql stable security definer set search_path = public, extensions as $$
declare
  v_ponto geography := st_setsrid(st_makepoint(p_lng, p_lat), 4326)::geography;
begin
  if not (eh_admin() or sou_instituicao_verificada()) then
    raise exception 'Sem permissão';
  end if;

  return query
  select d.utilizador_id,
         p.nome_completo,
         d.tipo_sanguineo,
         p.telefone,
         d.bairro,
         m.nome,
         pr.nome,
         round((st_distance(d.localizacao, v_ponto) / 1000.0)::numeric, 2),
         d.ultima_doacao_em,
         case when d.ultima_doacao_em is null then null
              else (current_date - d.ultima_doacao_em::date) end,
         ap.apto,
         ap.proxima_doacao_em,
         ap.motivos,
         case when d.partilhar_dados_saude then d.peso_kg end,
         case when d.partilhar_dados_saude then d.altura_cm end,
         case when d.partilhar_dados_saude then d.doencas_cronicas end,
         case when d.partilhar_dados_saude then d.medicacao end,
         case when d.partilhar_dados_saude then d.tatuagem_recente end,
         case when d.partilhar_dados_saude then d.viagem_recente end,
         case when d.partilhar_dados_saude then d.fumador end,
         case when d.partilhar_dados_saude then d.consome_alcool end
  from doadores d
  join perfis p on p.id = d.utilizador_id
  left join municipios m on m.id = d.municipio_id
  left join provincias pr on pr.id = d.provincia_id
  cross join lateral public.calcular_aptidao(d.utilizador_id) ap
  where d.disponivel
    and d.localizacao is not null
    and st_dwithin(d.localizacao, v_ponto, p_raio_km * 1000)
    and (p_categoria_id is null or exists (
          select 1 from doadores_categorias dc
          where dc.doador_id = d.utilizador_id and dc.categoria_id = p_categoria_id))
    and (p_tipo_sanguineo_recetor is null or exists (
          select 1 from compatibilidade_sanguinea c
          where c.tipo_doador = d.tipo_sanguineo and c.tipo_recetor = p_tipo_sanguineo_recetor))
    and (not p_apenas_aptos or ap.apto)
  order by d.localizacao <-> v_ponto
  limit least(p_limite, 200);
end $$;

-- Atalho: usa a localização da própria instituição como centro da pesquisa
create or replace function public.doadores_proximos_da_instituicao(
  p_instituicao_id         uuid,
  p_raio_km                numeric default 20,
  p_categoria_id           int default null,
  p_tipo_sanguineo_recetor public.tipo_sanguineo default null,
  p_apenas_aptos           boolean default false,
  p_limite                 int default 50
)
returns setof public.doador_proximo
language plpgsql stable security definer set search_path = public, extensions as $$
declare v_inst instituicoes;
begin
  select * into v_inst from instituicoes where id = p_instituicao_id;
  if not found then raise exception 'Instituição inexistente'; end if;
  if not (sou_dono_instituicao(p_instituicao_id) or eh_admin()) then
    raise exception 'Sem permissão';
  end if;
  if v_inst.estado <> 'verificada' and not eh_admin() then
    raise exception 'Instituição ainda não verificada';
  end if;
  if v_inst.lat is null or v_inst.lng is null then
    raise exception 'A instituição não tem localização definida';
  end if;

  return query
  select * from public.doadores_proximos(
    v_inst.lat, v_inst.lng, p_raio_km, p_categoria_id,
    p_tipo_sanguineo_recetor, p_apenas_aptos, p_limite);
end $$;

-- Instituições verificadas perto de um ponto (para o doador encontrar onde doar)
create or replace function public.instituicoes_proximas(
  p_lat double precision, p_lng double precision,
  p_raio_km numeric default 20,
  p_tipo public.tipo_instituicao default null
)
returns table (id uuid, nome text, tipo public.tipo_instituicao, endereco text, municipio text, provincia text, telefone text, distancia_km numeric)
language sql stable security definer set search_path = public, extensions as $$
  select i.id, i.nome, i.tipo, i.endereco, m.nome, pr.nome, i.telefone,
         round((st_distance(i.localizacao, st_setsrid(st_makepoint(p_lng, p_lat), 4326)::geography) / 1000.0)::numeric, 2)
  from instituicoes i
  left join municipios m on m.id = i.municipio_id
  left join provincias pr on pr.id = i.provincia_id
  where i.estado = 'verificada'
    and i.localizacao is not null
    and (p_tipo is null or i.tipo = p_tipo)
    and st_dwithin(i.localizacao, st_setsrid(st_makepoint(p_lng, p_lat), 4326)::geography, p_raio_km * 1000)
  order by i.localizacao <-> st_setsrid(st_makepoint(p_lng, p_lat), 4326)::geography
  limit 50;
$$;

-- Candidatos a doação de órgãos próximos: SÓ clínicas verificadas (ou admin)
create or replace function public.candidatos_orgaos_proximos(
  p_instituicao_id uuid,
  p_raio_km        numeric default 50,
  p_orgao_id       int default null,
  p_limite         int default 50
)
returns table (
  candidatura_id uuid, doador_id uuid, nome_completo text, telefone text,
  tipo_sanguineo public.tipo_sanguineo, tipo_doacao public.tipo_doacao_orgaos,
  orgaos text[], bairro text, municipio text, provincia text, distancia_km numeric, idade int
)
language plpgsql stable security definer set search_path = public, extensions as $$
declare
  v_inst  instituicoes;
  v_ponto geography;
begin
  select * into v_inst from instituicoes where id = p_instituicao_id;
  if not found then raise exception 'Instituição inexistente'; end if;
  if not eh_admin() then
    if not sou_dono_instituicao(p_instituicao_id)
       or v_inst.tipo <> 'clinica'
       or v_inst.estado <> 'verificada' then
      raise exception 'Apenas clínicas verificadas podem consultar candidatos a doação de órgãos';
    end if;
  end if;
  if v_inst.localizacao is null then
    raise exception 'A instituição não tem localização definida';
  end if;
  v_ponto := v_inst.localizacao;

  return query
  select c.id, d.utilizador_id, p.nome_completo, p.telefone, d.tipo_sanguineo, c.tipo_doacao,
         array_agg(o.nome order by o.nome),
         d.bairro, m.nome, pr.nome,
         round((st_distance(d.localizacao, v_ponto) / 1000.0)::numeric, 2),
         extract(year from age(d.data_nascimento))::int
  from candidaturas_orgaos c
  join doadores d on d.utilizador_id = c.doador_id
  join perfis p on p.id = d.utilizador_id
  join candidaturas_orgaos_itens i on i.candidatura_id = c.id
  join orgaos o on o.id = i.orgao_id
  left join municipios m on m.id = d.municipio_id
  left join provincias pr on pr.id = d.provincia_id
  where c.estado = 'ativa'
    and d.localizacao is not null
    and st_dwithin(d.localizacao, v_ponto, p_raio_km * 1000)
    and (p_orgao_id is null or exists (
          select 1 from candidaturas_orgaos_itens x
          where x.candidatura_id = c.id and x.orgao_id = p_orgao_id))
  group by c.id, d.utilizador_id, p.nome_completo, p.telefone, d.tipo_sanguineo, c.tipo_doacao,
           d.bairro, m.nome, pr.nome, d.localizacao, d.data_nascimento
  order by d.localizacao <-> v_ponto
  limit least(p_limite, 200);
end $$;

-- Quem respondeu a um alerta (para a instituição dona do alerta)
create or replace function public.respostas_do_alerta(p_alerta_id uuid)
returns table (
  doador_id uuid, nome_completo text, telefone text, tipo_sanguineo public.tipo_sanguineo,
  resposta public.tipo_resposta, mensagem text, respondido_em timestamptz
)
language plpgsql stable security definer set search_path = public as $$
begin
  if not (eh_admin() or exists (
        select 1 from alertas a where a.id = p_alerta_id and sou_dono_instituicao(a.instituicao_id))) then
    raise exception 'Sem permissão';
  end if;

  return query
  select r.doador_id, p.nome_completo, p.telefone, d.tipo_sanguineo, r.resposta, r.mensagem, r.criado_em
  from respostas_alertas r
  join perfis p on p.id = r.doador_id
  left join doadores d on d.utilizador_id = r.doador_id
  where r.alerta_id = p_alerta_id
  order by r.criado_em;
end $$;

