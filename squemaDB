-- Ao registar uma doação, atualiza a "última doação" do doador
create or replace function public.doacoes_depois_inserir()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  if new.categoria_id = (select id from categorias where slug = 'sangue') then
    update doadores
       set ultima_doacao_em = new.data_doacao
     where utilizador_id = new.doador_id
       and (ultima_doacao_em is null or ultima_doacao_em < new.data_doacao);
  end if;
  return new;
end $$;

create trigger doacoes_depois_inserir_trg
  after insert on public.doacoes
  for each row execute function public.doacoes_depois_inserir();

create or replace function public.registar_doacao(
  p_instituicao_id uuid,
  p_doador_id      uuid,
  p_data_doacao    timestamptz default now(),
  p_categoria_id   int default null,
  p_alerta_id      uuid default null,
  p_volume_ml      int default null,
  p_observacoes    text default null
)
returns uuid language plpgsql security definer set search_path = public as $$
declare v_id uuid; v_estado public.estado_instituicao;
begin
  if not (sou_dono_instituicao(p_instituicao_id) or eh_admin()) then
    raise exception 'Sem permissão';
  end if;
  select estado into v_estado from instituicoes where id = p_instituicao_id;
  if v_estado <> 'verificada' and not eh_admin() then
    raise exception 'Instituição ainda não verificada';
  end if;
  if p_data_doacao > now() then
    raise exception 'A data da doação não pode estar no futuro';
  end if;

  insert into doacoes (doador_id, instituicao_id, alerta_id, categoria_id, data_doacao,
                       volume_ml, observacoes, registada_por)
  values (p_doador_id, p_instituicao_id, p_alerta_id,
          coalesce(p_categoria_id, (select id from categorias where slug = 'sangue')),
          p_data_doacao, p_volume_ml, p_observacoes, auth.uid())
  returning id into v_id;

  return v_id;
end $$;

create or replace function public.definir_estado_instituicao(p_id uuid, p_estado public.estado_instituicao)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not eh_admin() then raise exception 'Apenas administradores'; end if;
  update instituicoes
     set estado = p_estado,
         verificada_em = case when p_estado = 'verificada' then now() end
   where id = p_id;
end $$;

-- Resumo mínimo para o painel admin (não expõe fatores de saúde individuais)
create or replace function public.admin_resumo_doadores()
returns jsonb
language plpgsql stable security definer
set search_path = ''
as $$
declare
  v_resultado jsonb;
begin
  if not public.eh_admin() then
    raise exception 'Apenas administradores';
  end if;

  with doadores_admin as (
    select
      d.utilizador_id,
      coalesce(p.nome_completo, 'Utilizador') as nome,
      p.telefone,
      d.tipo_sanguineo,
      d.disponivel,
      apt.apto as elegivel,
      apt.proxima_doacao_em,
      coalesce(assistencias.quantidade, 0) as doacoes_registadas
    from public.doadores d
    join public.perfis p on p.id = d.utilizador_id
    cross join lateral public.calcular_aptidao(d.utilizador_id) apt
    left join lateral (
      select count(*)::int as quantidade
      from public.doacoes dc
      where dc.doador_id = d.utilizador_id
    ) assistencias on true
  )
  select jsonb_build_object(
    'total', count(*)::int,
    'elegiveis', count(*) filter (where elegivel)::int,
    'nao_elegiveis', count(*) filter (where not elegivel)::int,
    'disponiveis', count(*) filter (where disponivel)::int,
    'indisponiveis', count(*) filter (where not disponivel)::int,
    'tipos_sanguineos', coalesce((
      select jsonb_agg(
        jsonb_build_object('tipo', grupos.tipo, 'quantidade', grupos.quantidade)
        order by grupos.ordem
      )
      from (
        select bg.tipo::text as tipo, bg.ordem, count(da.utilizador_id)::int as quantidade
        from unnest(enum_range(null::public.tipo_sanguineo)) with ordinality as bg(tipo, ordem)
        left join doadores_admin da on da.tipo_sanguineo = bg.tipo
        group by bg.tipo, bg.ordem

        union all

        select 'Não informado', 9, count(*)::int
        from doadores_admin da
        where da.tipo_sanguineo is null
      ) grupos
    ), '[]'::jsonb),
    'doadores', coalesce(jsonb_agg(
      jsonb_build_object(
        'id', utilizador_id,
        'nome', nome,
        'telefone', telefone,
        'tipo_sanguineo', tipo_sanguineo,
        'elegivel', elegivel,
        'disponivel', disponivel,
        'proxima_doacao_em', proxima_doacao_em,
        'doacoes_registadas', doacoes_registadas
      ) order by nome
    ), '[]'::jsonb)
  )
  into v_resultado
  from doadores_admin;

  return v_resultado;
end $$;

-- Webhook de SMS (só service_role)
create or replace function public.registar_resposta_sms(
  p_telefone text, p_codigo text, p_resposta public.tipo_resposta
)
returns text language plpgsql security definer set search_path = public as $$
declare v_tel text; v_doador uuid; v_alerta uuid;
begin
  v_tel := regexp_replace(coalesce(p_telefone, ''), '[^0-9+]', '', 'g');
  if v_tel !~ '^\+' then v_tel := '+' || v_tel; end if;

  select id into v_doador from perfis
   where telefone = v_tel and papel = 'doador'
   order by criado_em limit 1;
  if v_doador is null then return 'telefone_desconhecido'; end if;

  select a.id into v_alerta
  from alertas a
  where a.codigo_curto = trim(p_codigo)
    and a.estado = 'ativo'
    and exists (select 1 from notificacoes n where n.alerta_id = a.id and n.doador_id = v_doador);
  if v_alerta is null then return 'sem_alerta_ativo'; end if;

  insert into respostas_alertas (alerta_id, doador_id, resposta, mensagem)
  values (v_alerta, v_doador, p_resposta, 'via SMS')
  on conflict (alerta_id, doador_id) do nothing;

  return 'ok';
end $$;

