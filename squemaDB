-- 3. UTILIZADORES, DOADORES E INSTITUIÇÕES
-- ---------------------------------------------------------------------
create table public.perfis (
  id             uuid primary key references auth.users(id) on delete cascade,
  papel          public.papel_utilizador not null default 'doador',
  nome_completo  text,
  telefone       text check (telefone is null or telefone ~ '^\+[1-9][0-9]{7,14}$'),
  url_avatar     text,
  criado_em      timestamptz not null default now()
);

create unique index perfis_telefone_uidx on public.perfis (telefone) where telefone is not null;

create table public.doadores (
  utilizador_id         uuid primary key references public.perfis(id) on delete cascade,
  tipo_sanguineo        public.tipo_sanguineo,
  sexo                  public.sexo,
  data_nascimento       date,
  -- localização
  lat                   double precision check (lat between -90 and 90),
  lng                   double precision check (lng between -180 and 180),
  localizacao           geography(Point, 4326) generated always as (
                          case
                            when lat is not null and lng is not null
                            then ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography
                            else null
                          end
                        ) stored,
  bairro                text,
  provincia_id          int references public.provincias(id),
  municipio_id          int references public.municipios(id),
  -- preferências de alertas
  distancia_maxima_km   numeric not null default 10 check (distancia_maxima_km between 1 and 100),
  nivel_minimo_alerta   public.nivel_alerta not null default 'atencao',
  disponivel            boolean not null default true,
  horario_preferencial  text check (horario_preferencial is null or horario_preferencial in ('manha','tarde','qualquer')),
  raio_deslocacao       text check (raio_deslocacao is null or raio_deslocacao in ('5km','municipio','provincia','pais')),
  -- privacidade
  perfil_publico        boolean not null default true,   -- aparece em doadores_publicos (tipo sanguíneo + telefone)
  partilhar_dados_saude boolean not null default false,  -- instituições veem os fatores de saúde
  -- última doação
  ultima_doacao_em      timestamptz,
  -- fatores de saúde
  peso_kg               numeric check (peso_kg is null or peso_kg between 40 and 200),
  altura_cm             numeric check (altura_cm is null or altura_cm between 140 and 220),
  doencas_cronicas      text check (doencas_cronicas is null or doencas_cronicas in ('nenhuma','hipertensao','diabetes','anemia_falciforme','outra')),
  medicacao             text check (medicacao is null or medicacao in ('nao','anticoagulantes','antibioticos','outro')),
  tatuagem_recente      boolean not null default false,
  viagem_recente        boolean not null default false,
  fumador               boolean not null default false,
  consome_alcool        boolean not null default false,
  atualizado_em         timestamptz not null default now()
);

create index doadores_localizacao_gix on public.doadores using gist (localizacao);
create index doadores_tipo_sanguineo_idx on public.doadores (tipo_sanguineo);
create index doadores_provincia_idx on public.doadores (provincia_id);
create index doadores_municipio_idx on public.doadores (municipio_id);

create table public.doadores_categorias (
  doador_id     uuid references public.doadores(utilizador_id) on delete cascade,
  categoria_id  int  references public.categorias(id) on delete cascade,
