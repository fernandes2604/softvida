-- =====================================================================
-- Plataforma Doadores <-> Instituições (Angola, âmbito nacional)
-- SQL COMPLETO (v4, em português) = v3 + PEDIDOS DE DOAÇÃO
--
-- Executar num projeto Supabase novo (ou apagar antes as tabelas antigas).
-- Se "create extension pg_cron" falhar, ative-a primeiro em
-- Database > Extensions.
--
-- Regras principais:
--  * Doadores cadastram-se a si mesmos (trigger em auth.users).
--  * Qualquer pessoa (mesmo sem login) vê, na vista "doadores_publicos",
--    APENAS tipo sanguíneo + telefone (e só de quem deixou perfil_publico).
--  * Instituições verificadas recebem dados dos doadores próximos através
--    de funções (doadores_proximos...). Dados de saúde só aparecem se o
--    doador consentiu (partilhar_dados_saude).
--  * Doador vê sempre os seus próprios dados de saúde, aptidão e tempo
--    desde a última doação (minha_aptidao()).
--  * Candidatura a doador de órgãos: só clínicas verificadas a recebem.
--  * PEDIDOS DE DOAÇÃO (secções 18 a 25): qualquer pessoa pode solicitar;
--    o pedido é atribuído à instituição verificada mais próxima, que
--    aceita/recusa e atende no terreno. Recusa ou falta de resposta ->
--    passa automaticamente para a seguinte mais próxima.
--
-- Fluxo dos pedidos:
--  1. solicitar_doacao(...) -> devolve um código de acompanhamento.
--  2. Atribuição à instituição verificada mais próxima (sangue -> só
--     hospital/clínica/banco de sangue).
--  3. responder_pedido (aceitar/recusar).
--  4. atualizar_pedido: aceite -> em_deslocacao -> concluido.
--  5. Opcional: criar_alerta_do_pedido (alerta para doadores próximos).
--  6. O solicitante acompanha com acompanhar_pedido(codigo).
-- =====================================================================

create extension if not exists postgis with schema extensions;
create extension if not exists pg_cron;

