-- Expira alertas e alarga o raio dos que ainda não têm doadores suficientes
create or replace function public.escalar_alertas()
returns integer language plpgsql security definer set search_path = public as $$
declare r record; total int := 0;
begin
  update alertas set estado = 'expirado'
  where estado = 'ativo' and expira_em < now();

  for r in
    select a.id, a.raio_atual_km, c.raio_maximo_km
    from alertas a
    join configuracao_niveis_alerta c on c.nivel = a.nivel
    where a.estado = 'ativo'
      and c.escalar_apos_minutos is not null
      and a.raio_atual_km < c.raio_maximo_km
      and now() - coalesce(a.ultima_escalada_em, a.criado_em)
          >= make_interval(mins => c.escalar_apos_minutos)
      and (select count(*) from respostas_alertas ra
           where ra.alerta_id = a.id and ra.resposta = 'aceite') < a.doadores_necessarios
  loop
    update alertas
      set raio_atual_km      = least(r.raio_atual_km * 1.5, r.raio_maximo_km),
          numero_escaladas   = numero_escaladas + 1,
          ultima_escalada_em = now()
      where id = r.id;
    total := total + despachar_alerta(r.id);
  end loop;
  return total;
end $$;

select cron.schedule('escalar-alertas', '* * * * *', $$select public.escalar_alertas()$$);

-- Fecha o alerta quando há aceites suficientes
create or replace function public.respostas_depois_inserir()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  update alertas a set estado = 'cumprido'
  where a.id = new.alerta_id and a.estado = 'ativo'
    and (select count(*) from respostas_alertas
         where alerta_id = a.id and resposta = 'aceite') >= a.doadores_necessarios;
  return new;
end $$;

create trigger respostas_depois_inserir_trg
  after insert on public.respostas_alertas
  for each row execute function public.respostas_depois_inserir();

