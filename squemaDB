);

create table public.instituicoes (
  id            uuid primary key default gen_random_uuid(),
  dono_id       uuid not null references public.perfis(id) on delete cascade,
  nome          text not null,
  tipo          public.tipo_instituicao not null default 'outra',
  descricao     text,
  nif           text,
  telefone      text,
  endereco      text,
  provincia_id  int references public.provincias(id),
  municipio_id  int references public.municipios(id),
  lat           double precision check (lat between -90 and 90),
  lng           double precision check (lng between -180 and 180),
  localizacao   geography(Point, 4326) generated always as (
                  case
                    when lat is not null and lng is not null
                    then ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography
                    else null
                  end
                ) stored,
  estado        public.estado_instituicao not null default 'pendente',
